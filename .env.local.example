# Capiflo Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# FORM SUBMISSIONS
# ===========================================

# Email address to receive form submissions
EMAIL_TO=hello@capiflo.co.uk

# Resend API key for sending emails
# Get yours at https://resend.com
# Leave empty to skip email sending (webhook only)
RESEND_API_KEY=

# Webhook URL for CRM integration (HubSpot, Zapier, Make, etc.)
# Leave empty to skip webhook (email only)
# Example Zapier: https://hooks.zapier.com/hooks/catch/xxxxx/xxxxx
# Example Make: https://hook.eu1.make.com/xxxxx
# Example HubSpot: https://api.hubapi.com/webhooks/v1/xxxxx
WEBHOOK_URL=

# ===========================================
# ANALYTICS (Optional)
# ===========================================

# Vercel Analytics is enabled by default when deployed to Vercel
# No configuration needed - it uses the VERCEL_ANALYTICS_ID automatically

# ===========================================
# SITE CONFIGURATION
# ===========================================
# The canonical site URL lives in src/config/seo.ts (seoConfig.siteUrl) —
# no env var needed for it.

# ===========================================
# SEO RESEARCH (scripts/seo + npm run seo:*)
# ===========================================

# DataForSEO Basic-auth header, base64 of "login:password".
# Generate with: printf '%s:%s' "$LOGIN" "$PASSWORD" | base64
# Used by scripts/seo/run-research.ts and the dataforseo-content-engine scripts.
DATAFORSEO_AUTH=
